<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.maisem.tailmixd</string>
  <key>ProgramArguments</key>
  <array>
    <string>@INSTALL_ROOT@/current/tailmixd</string>
    <string>-state=@STATE_DIR@/state.json</string>
    <string>-socket-dir=/var/run/tailmix</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/var/log/tailmixd.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/tailmixd.log</string>
</dict>
</plist>
